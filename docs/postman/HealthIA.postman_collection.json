      "key": "tokenPaciente",
      "value": ""
    },
    {
      "key": "extracaoId",
      "value": ""
    },
    {
      "key": "versaoTermo",
      "value": ""
    },
    {
      "key": "declaracoes",
      "value": "[]"
    },
    {
      "key": "pacienteId",
      "value": "u-002"
    },
    {
      "key": "sumarioFichaId",
      "value": ""
