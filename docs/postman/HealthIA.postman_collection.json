            "description": "Gere o base64 no PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes('alta-ficticia.pdf')). O texto volta para conferência e não é salvo. Até 10 MB.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome_arquivo\": \"alta-ficticia.pdf\",\n  \"pdf_base64\": \"COLE_AQUI_O_PDF_EM_BASE64\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
