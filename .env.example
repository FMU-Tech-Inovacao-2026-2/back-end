# Copie para .env e ajuste localmente. Nunca versione o .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Origens permitidas no CORS, separadas por vírgula (front Vite por padrão).
# Em produção, informe a URL exata do front-end (sem *).
CORS_ORIGIN=http://localhost:5173

# Quantidade de proxies confiáveis à frente da API (Cloud Run = 1; local = 0).
TRUST_PROXY=0

# Segredo de assinatura do JWT (mínimo 32 caracteres). Gere um novo com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-longo
# Validade do token em segundos (3600 = 1 hora; máximo 43200)
JWT_EXPIRES_IN_SECONDS=3600

# Como a extração é feita:
#   api-key      → Gemini Developer API com GEMINI_API_KEY
#   vertex       → Gemini no Vertex AI com credenciais do Google Cloud (ADC), sem chave
#   demonstracao → respostas preparadas só para os sumários fictícios do catálogo, sem IA
GEMINI_PROVEDOR=demonstracao
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Libera NODE_ENV=production com repositórios em memória e contas fictícias.
# Só para piloto acadêmico com dados inventados; nunca para dados reais.
HEALTHIA_MODO_PILOTO=false
