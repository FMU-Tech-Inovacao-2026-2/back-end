NODE_ENV=development
PORT=3000
GEMINI_API_KEY=sua_chave_aqui

# Origens permitidas no CORS, separadas por vírgula (front Vite por padrão)
CORS_ORIGIN=http://localhost:5173

# Segredo de assinatura do JWT (mínimo 32 caracteres). Gere um novo com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-longo
# Validade do token em segundos (3600 = 1 hora)
JWT_EXPIRES_IN_SECONDS=3600
